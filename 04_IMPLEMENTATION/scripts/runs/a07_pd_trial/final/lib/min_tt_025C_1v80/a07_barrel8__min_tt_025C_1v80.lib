    bus("mode") {
      bus_type : mode;
      direction : input;
      capacitance : 0.0000;
    pin("mode[1]") {
      direction : input;
      capacitance : 0.0035;
    }
    pin("mode[0]") {
      direction : input;
      capacitance : 0.0034;
    }
    }
    bus("shamt") {
      bus_type : shamt;
      direction : input;
      capacitance : 0.0000;
    pin("shamt[2]") {
      direction : input;
      capacitance : 0.0032;
    }
    pin("shamt[1]") {
      direction : input;
      capacitance : 0.0035;
    }
    pin("shamt[0]") {
      direction : input;
      capacitance : 0.0033;
    }
    }
  }

}
