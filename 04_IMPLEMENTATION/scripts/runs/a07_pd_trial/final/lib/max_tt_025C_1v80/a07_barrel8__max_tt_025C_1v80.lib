    bus("mode") {
      bus_type : mode;
      direction : input;
      capacitance : 0.0000;
    pin("mode[1]") {
      direction : input;
      capacitance : 0.0037;
    }
    pin("mode[0]") {
      direction : input;
      capacitance : 0.0036;
    }
    }
    bus("shamt") {
      bus_type : shamt;
      direction : input;
      capacitance : 0.0000;
    pin("shamt[2]") {
      direction : input;
      capacitance : 0.0033;
    }
    pin("shamt[1]") {
      direction : input;
      capacitance : 0.0037;
    }
    pin("shamt[0]") {
      direction : input;
      capacitance : 0.0034;
    }
    }
  }

}
