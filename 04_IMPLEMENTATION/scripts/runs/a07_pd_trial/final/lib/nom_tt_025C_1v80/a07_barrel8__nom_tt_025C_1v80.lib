    bus("mode") {
      bus_type : mode;
      direction : input;
      capacitance : 0.0000;
    pin("mode[1]") {
      direction : input;
      capacitance : 0.0036;
    }
    pin("mode[0]") {
      direction : input;
      capacitance : 0.0035;
    }
    }
    bus("shamt") {
      bus_type : shamt;
      direction : input;
      capacitance : 0.0000;
    pin("shamt[2]") {
      direction : input;
      capacitance : 0.0033;
    }
    pin("shamt[1]") {
      direction : input;
      capacitance : 0.0036;
    }
    pin("shamt[0]") {
      direction : input;
      capacitance : 0.0034;
    }
    }
  }

}
